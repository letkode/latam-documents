{
    "name": "letkode/latam-documents",
    "description": "Latin American and Spanish document validation, normalization and formatting (DNI, RUT, CPF, CNPJ, CURP, RFC, CI, RUC, NIF, NIE, CIF and more).",
    "type": "library",
    "license": "MIT",
    "keywords": ["latam", "document", "validation", "dni", "rut", "cpf", "curp", "nif"],
    "require": {
        "php": "^8.4",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "symfony/translation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Letkode\\LatamDocument\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letkode\\LatamDocument\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable"
}